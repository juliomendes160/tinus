{
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "terminal.integrated.profiles.windows": {
        "Git Bash": {
            "source": "Git Bash",
            "args": [
                "--rcfile", "${workspaceFolder}\\.bash\\.bash_profile",
            ],
            "env": {
                "WORKSPACE":"${workspaceFolder}\\.bash\\.bashrc"
            }
        }
    },
}

